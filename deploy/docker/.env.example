# Copy to `.env` (git-ignored) next to compose.yaml and set the password. Every SOURCEGULL_*
# variable here reaches the server (docs/configuration.md lists them all).

# Image
SOURCEGULL_IMAGE=ghcr.io/sourcegull/sourcegull
SOURCEGULL_VERSION=0.1.0

# PostgreSQL (the `postgres` service). compose.yaml builds the connection URL from this
# password; set SOURCEGULL_DATABASE_URL instead for another database (URL-encode special
# characters in its password).
POSTGRES_PASSWORD=change-me
# SOURCEGULL_DATABASE_URL=postgres://sourcegull:change-me@postgres:5432/sourcegull?sslmode=disable
# Size shared_buffers to ~25% of the memory given to PostgreSQL.
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# Public URL users reach Sourcegull at (default for the site config `externalURL`).
SOURCEGULL_EXTERNAL_URL=http://localhost:7080
SOURCEGULL_HTTP_PORT=7080

# Encryption keys: compose.yaml creates /var/opt/sourcegull/keys in the sourcegull-data volume on
# first start. Or pass them in the environment (comma-separated `id:base64key` entries, the last
# one current) and no file is created:
# SOURCEGULL_KEYS=k1:...

# Configuration as code: files in ./config, mounted at /etc/sourcegull/config. Each is read-only in
# the UI while set; ${env:NAME} references come from config/secrets.env.
# SOURCEGULL_SITE_CONFIG_FILE=/etc/sourcegull/config/site-config.jsonc
# SOURCEGULL_RESOURCES_FILE=/etc/sourcegull/config/resources.jsonc
# SOURCEGULL_GLOBAL_SETTINGS_FILE=/etc/sourcegull/config/global-settings.jsonc

# Logging: json|pretty, and RUST_LOG filters.
# SOURCEGULL_LOG_FORMAT=json
# RUST_LOG=info

# Blob store (SCIP uploads, code graph files, search job results): the data volume by default.
# For an S3-compatible bucket (compose.minio.yaml runs a MinIO):
# SOURCEGULL_BLOB_STORE=s3://sourcegull            # s3://<bucket>[/<prefix>]
# SOURCEGULL_S3_ENDPOINT=http://minio:9000     # empty: Amazon S3
# SOURCEGULL_S3_REGION=us-east-1
# SOURCEGULL_S3_PATH_STYLE=true                # false: virtual-hosted style (bucket.host)
# SOURCEGULL_S3_CREATE_BUCKET=true             # create the bucket at startup if missing
# SOURCEGULL_S3_ACCESS_KEY_ID=sourcegull
# SOURCEGULL_S3_SECRET_ACCESS_KEY=change-me
# MinIO's root user and password (use them as the keys above, or create an access key in its
# console on 127.0.0.1:9001):
# MINIO_ROOT_USER=sourcegull
# MINIO_ROOT_PASSWORD=change-me
# MINIO_CONSOLE_PORT=9001

# Executor (compose.executor.yaml, or the `executors` profile of compose.production.yaml): the
# same value as `executors.accessToken` in the site config (20+ characters), and the group id
# owning /var/run/docker.sock on this host (`stat -c %g /var/run/docker.sock`).
# SOURCEGULL_EXECUTOR_TOKEN=
# DOCKER_GID=999
# Compose defaults, which differ from the binary's (`codeintel`, 1 job, no memory limit):
# SOURCEGULL_EXECUTOR_QUEUES=codeintel,batches
# SOURCEGULL_EXECUTOR_MAX_JOBS=2
# SOURCEGULL_EXECUTOR_DOCKER_MEMORY=8g

# ---------------------------------------------------------------------------------------------
# Production layout (compose.production.yaml) only. Uncomment the first line to make it the
# default for every `docker compose` command in this directory.
# COMPOSE_FILE=compose.production.yaml
#
# It needs an encryption key file, mounted as a Compose secret at /run/secrets/encryption-keys.
# Create it once and back it up; losing it makes encrypted data (tokens, credentials) unreadable:
#   mkdir -p secrets && printf 'k1:%s\n' "$(openssl rand -base64 32)" > secrets/encryption-keys
#   chmod 0644 secrets/encryption-keys
# SOURCEGULL_KEYS_FILE_HOST=./secrets/encryption-keys
# With SOURCEGULL_KEYS instead: also set SOURCEGULL_KEYS_FILE= (empty) and
# SOURCEGULL_KEYS_FILE_HOST=/dev/null.
#
# Database connections per process: the main pool, and the worker role's own pool when it runs
# next to other roles. Each process also holds one LISTEN connection, and each worker one per
# leader lease; keep the sum over all containers below Postgres' max_connections.
# SOURCEGULL_DB_MAX_CONNECTIONS=20
# SOURCEGULL_DB_WORKER_MAX_CONNECTIONS=10
#
# Memory limits.
# POSTGRES_MEMORY_LIMIT=4g
# POSTGRES_LOG_MIN_DURATION=1000      # log statements slower than this many ms (-1: off)
# SOURCEGULL_WEB_MEMORY_LIMIT=2g
# SOURCEGULL_WORKER_MEMORY_LIMIT=2g
# SOURCEGULL_REPO_MEMORY_LIMIT=8g
# SOURCEGULL_BLOB_MEMORY_LIMIT=512m
#
# Repo nodes (one Compose service and volume each). List every node, comma-separated. With an
# S3 bucket, stop the blob service: `docker compose up -d --scale blob=0`.
# SOURCEGULL_REPO_NODES=http://repo-0:3178
