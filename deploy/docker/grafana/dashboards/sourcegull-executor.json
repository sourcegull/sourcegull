          "expr": "max by (queue, state) (sourcegull_queue_jobs{queue=~\"codeintel_index_jobs|batch_spec_workspace_execution_jobs\",state=~\"queued|processing\"})",
          "legendFormat": "{{queue}} {{state}}",
          "range": true,
          "refId": "A"
        }
      ],
