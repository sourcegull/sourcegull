      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (queue) (sourcegull_queue_jobs{queue=~\"codeintel_index_jobs|batch_spec_workspace_execution_jobs\",state=\"queued\"}))\n* on() (max(sourcegull_executors_active) == bool 0)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "queued executor jobs while no executor is active",
      "type": "timeseries"
    },
    {
      "collapsed": false,
