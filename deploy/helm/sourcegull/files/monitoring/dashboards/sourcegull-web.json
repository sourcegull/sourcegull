      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(sourcegull_http_requests_total{role=\"web\",route!~\"/metrics|/healthz|/readyz\",status=~\"5..\"}[5m])) or 0 * sum(rate(sourcegull_http_requests_total{role=\"web\",route!~\"/metrics|/healthz|/readyz\"}[5m])))\n/ sum(rate(sourcegull_http_requests_total{role=\"web\",route!~\"/metrics|/healthz|/readyz\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "share of requests answered with 5xx",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Alerts (warning): web: 90th percentile request duration by route above 5s for 15m.\n\nNext steps: https://github.com/sourcegull/sourcegull/blob/main/docs/observability/alerts.md#web_http_p90_latency",
